{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "joguitos",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  // O site (React) é servido como arquivos estáticos; só /parties/* (salas) e /api/* (mural) passam pelo Worker.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/parties/*", "/api/*"]
  },
  // Cada sala é um Durable Object. Classes SQLite são as únicas liberadas no plano gratuito.
  "durable_objects": {
    "bindings": [
      { "name": "Room", "class_name": "Room" },
      // Mural da galera: um único objeto com as fotos (SQLite).
      { "name": "Mural", "class_name": "Mural" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["Mural"] }
  ],
  "observability": { "enabled": true }
}
